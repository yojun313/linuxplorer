PORT=8003
ROOT_DIR=/home/your-user
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset to use a private persisted session key in .state/session.key.
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
# Set true for HTTPS production behind a proxy, false for local HTTP.
COOKIE_SECURE=false
